# IronCurtain builds every image under a build-hash tag and passes the exact
# base build it resolved (ironcurtain-base:build-<hash>), so a concurrent build
# from another checkout cannot swap the base under this one. The default keeps
# a manual `docker build` working against the moving alias.
ARG IRONCURTAIN_BASE_IMAGE=ironcurtain-base:latest
FROM ${IRONCURTAIN_BASE_IMAGE}

# Install Claude Code CLI (Node.js is already in the base image).
# Pinned to the version qualified with this IronCurtain release
# (CLAUDE_CODE_CLI_VERSION in src/docker/agent-cli-version.ts; a test ties the
# two together). The version is part of this file, so a bump changes the image
# build hash and triggers a rebuild. `agentCliVersions["claude-code"]` in
# ~/.ironcurtain/config.json overrides it with an exact version or "latest"
# (passed as this build arg and folded into the build hash).
ARG CLAUDE_CODE_VERSION=2.1.292
USER root
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"

# The entrypoint script copies runtime-generated config into the right
# location before the agent is invoked via docker exec. It sources the
# shared UID/GID remap helper, so that must be present too.
COPY entrypoint-uid-remap.sh /usr/local/bin/ironcurtain-uid-remap.sh
COPY entrypoint-claude-code.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER codespace

# Pre-seed Claude Code config so it skips interactive prompts:
# - .claude.json: marks onboarding complete (skips login flow)
# - .claude/settings.json: accepts bypass-permissions mode, skips web fetch preflight
RUN mkdir -p /home/codespace/.claude && \
    echo '{"hasCompletedOnboarding":true,"numStartups":1,"projects":{"/workspace":{"allowedTools":[],"hasTrustDialogAccepted":true}}}' \
      > /home/codespace/.claude.json && \
    echo '{"permissions":{"allow":[],"deny":[]},"skipDangerousModePermissionPrompt":true,"skipWebFetchPreflight":true}' \
      > /home/codespace/.claude/settings.json

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
